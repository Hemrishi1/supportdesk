# SupportDesk Environment Configuration
# Copy this file to .env and fill in your API key:
#   copy .env.example .env

# Google Gemini API Key (Recommended)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model (default: gemini-2.5-flash)
# Alternatives: gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Optional: OpenAI API Key (if using OpenAI instead)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-5.2

# Optional: Force provider when multiple keys are set ('gemini' or 'openai')
# AI_PROVIDER=gemini

# Optional: Server Port (default: 8765)
# PORT=8765
